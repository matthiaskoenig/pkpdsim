name: CI

on: [push]

jobs:
  simulate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Install uv and set the python version
        uses: astral-sh/setup-uv@v5
        with:
          python-version: "{{ python }}"
          enable-cache: true

      - name: Install dependencies
        run: uv sync --locked

      - name: Create the models
        run: uv run run_simulation {{ model.package }} --action factory

      - name: List the experiments
        run: uv run run_simulation {{ model.package }} --action list_experiments

  docker:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Build Docker image
        uses: docker/build-push-action@v5
        with:
          context: .
          tags: cicd:latest
          push: false
          cache-from: type=gha
          cache-to: type=gha,mode=max
